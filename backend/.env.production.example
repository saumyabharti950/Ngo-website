# cPanel Backend Environment Configuration
NODE_ENV=production
PORT=5000

# Database credentials (From cPanel -> MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=yourcpaneluser_dbuser
DB_PASSWORD=your_database_password
DB_DATABASE=yourcpaneluser_dbname

# Security Secrets (Must be at least 32 characters)
JWT_SECRET=sifi_ngo_jwt_production_secret_key_32_chars_long
JWT_EXPIRES_IN=7d
PAYMENT_ENCRYPTION_KEY=sifi_ngo_payment_secret_encryption_32_chars_long

# Allowed Frontend URLs for CORS (Without trailing slash, comma separated)
FRONTEND_URL=https://yourdomain.com,https://www.yourdomain.com

# File uploads folder
UPLOAD_DIR=uploads
